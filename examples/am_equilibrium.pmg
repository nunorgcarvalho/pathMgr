# One assortative-mating transmission unit at equilibrium:
# a mated pair (m, f) and their two full-sib children (o1, o2).
#
# This is the same model as `am_pair_with_two_children()` in tests/test_am_spec_spike.py,
# written in the text grammar instead of with builder calls. A test asserts the two produce
# an identical model -- that is the contract of the text front-end.

units: unstandardized
latent: g_m, e_m, g_f, e_f, g_o1, e_o1, s_o1, g_o2, e_o2, s_o2
positive: V_A_eq, V_E, V_K, V_A0

label: g_m = $g_{m}$
label: e_m = $e_{m}$
label: y_m = $y_{m}$
label: g_f = $g_{f}$
label: e_f = $e_{f}$
label: y_f = $y_{f}$
label: g_o1 = $g_{o1}$
label: e_o1 = $e_{o1}$
label: y_o1 = $y_{o1}$
label: s_o1 = $s_{o1}$
label: g_o2 = $g_{o2}$
label: e_o2 = $e_{o2}$
label: y_o2 = $y_{o2}$
label: s_o2 = $s_{o2}$

# phenotype: y = g + e
y_m  ~ g_m  + e_m
y_f  ~ g_f  + e_f
y_o1 ~ g_o1 + e_o1
y_o2 ~ g_o2 + e_o2

# transmission: g_o = (g_m + g_f)/2 + s_o
g_o1 ~ 1/2*g_m + 1/2*g_f + s_o1
g_o2 ~ 1/2*g_m + 1/2*g_f + s_o2

# parents are exogenous at the equilibrium scale; assortment correlates their g
g_m ~~ V_A_eq*g_m
g_f ~~ V_A_eq*g_f
g_m ~~ (rho_g*V_A_eq)*g_f

e_m  ~~ V_E*e_m
e_f  ~~ V_E*e_f
e_o1 ~~ V_E*e_o1
e_o2 ~~ V_E*e_o2
s_o1 ~~ V_K*s_o1
s_o2 ~~ V_K*s_o2

# each parent's environment is correlated with the OTHER parent's genes -- the term that
# makes lineal relatives differ from collateral ones under assortative mating
e_m ~~ (rho_g*V_E)*g_f
e_f ~~ (rho_g*V_E)*g_m

# the coupled equilibrium fixed point -- to be solved, never traced
assume: rho_g = rho_y*h2_eq
assume: h2_eq = V_A_eq/(V_A_eq + V_E)
assume: V_A_eq = V_A0/(1 - rho_g)
assume: V_K = V_A0/2
