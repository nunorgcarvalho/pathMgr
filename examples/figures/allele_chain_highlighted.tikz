\definecolor{pmC1F77B4}{HTML}{1F77B4}
\definecolor{pmCBBBBBB}{HTML}{BBBBBB}
\begin{tikzpicture}[
  every node/.style={font=\small},
  pmObserved/.style={draw=black, fill=white, rectangle, inner sep=0.06cm, minimum width=0.38cm, minimum height=0.34cm},
  pmLatent/.style={draw=black, fill=white, ellipse, inner xsep=0.07cm, inner ysep=0.13cm, minimum width=0.38cm, minimum height=0.34cm},
  pmDirected/.style={-{Stealth[length=2mm]}, line width=0.7pt},
  pmBidirected/.style={{Stealth[length=2mm]}-{Stealth[length=2mm]}, line width=0.7pt},
  pmCopath/.style={line width=1.6pt},
  pmLabel/.style={midway, fill=white, inner sep=1pt},
]
  \node[pmLatent] (z_mat_m) at (0.000,1.900) {$z^{(m)}_{m}$};
  \node[pmLatent] (z_pat_m) at (1.800,1.900) {$z^{(p)}_{m}$};
  \node[pmLatent] (g_m) at (0.900,0.000) {$g_m$};
  \node[pmLatent] (e_m) at (2.700,0.000) {$e_m$};
  \node[pmLatent] (z_mat_p) at (5.800,1.900) {$z^{(m)}_{p}$};
  \node[pmLatent] (z_pat_p) at (7.600,1.900) {$z^{(p)}_{p}$};
  \node[pmLatent] (g_p) at (6.700,0.000) {$g_p$};
  \node[pmLatent] (e_p) at (4.900,0.000) {$e_p$};
  \node[pmObserved] (y_m) at (1.400,-2.000) {$y_m$};
  \node[pmObserved] (y_p) at (6.200,-2.000) {$y_p$};
  \draw[pmDirected, draw=pmC1F77B4, line width=1.82pt] (z_mat_m) -- node[pmLabel, text=pmC1F77B4] {$\beta$} (g_m);
  \draw[pmDirected, draw=pmCBBBBBB] (z_pat_m) -- node[pmLabel, text=pmCBBBBBB] {$\beta$} (g_m);
  \draw[pmDirected, draw=pmC1F77B4, line width=1.82pt] (z_mat_p) -- node[pmLabel, text=pmC1F77B4] {$\beta$} (g_p);
  \draw[pmDirected, draw=pmCBBBBBB] (z_pat_p) -- node[pmLabel, text=pmCBBBBBB] {$\beta$} (g_p);
  \draw[pmDirected, draw=pmC1F77B4, line width=1.82pt] (g_m) -- (y_m);
  \draw[pmDirected, draw=pmCBBBBBB] (e_m) -- (y_m);
  \draw[pmDirected, draw=pmC1F77B4, line width=1.82pt] (g_p) -- (y_p);
  \draw[pmDirected, draw=pmCBBBBBB] (e_p) -- (y_p);
  \draw[pmBidirected, draw=pmC1F77B4, line width=1.82pt] (z_mat_m) to[loop above, looseness=6, in=120, out=60] node[pmLabel, text=pmC1F77B4] {$\frac{1}{2}$} (z_mat_m);
  \draw[pmBidirected, draw=pmC1F77B4, line width=1.82pt] (z_mat_p) to[loop above, looseness=6, in=120, out=60] node[pmLabel, text=pmC1F77B4] {$\frac{1}{2}$} (z_mat_p);
  \draw[pmCopath, draw=pmC1F77B4, line width=4.16pt] (y_m) -- node[pmLabel, text=pmC1F77B4] {$\left[\rho_{y}\right]$} (y_p);
  \node[align=center] at (3.800,-3.350) {$z^{(m)}_{m} \leftrightarrow z^{(m)}_{m} \rightarrow g_m \rightarrow y_m \;\text{---}\; y_p \leftarrow g_p \leftarrow z^{(m)}_{p} \leftrightarrow z^{(m)}_{p}$\\$\operatorname{Cov}\left[z^{(m)}_{m}, z^{(m)}_{p}\right] = \frac{1}{2} \cdot \beta \cdot \frac{\rho_{y}}{V_{E} + \beta^{2}} \cdot \beta \cdot \frac{1}{2} = \frac{\beta^{2} \rho_{y}}{4 \left(V_{E} + \beta^{2}\right)}$};
\end{tikzpicture}
