\definecolor{pmCB03A2E}{HTML}{B03A2E}
\begin{tikzpicture}[
  every node/.style={font=\small},
  pmObserved/.style={draw=black, fill=white, rectangle, inner sep=0.09cm, minimum width=0.42cm, minimum height=0.34cm},
  pmLatent/.style={draw=black, fill=white, ellipse, inner sep=0.16cm, minimum width=0.42cm, minimum height=0.34cm},
  pmDirected/.style={-{Stealth[length=2mm]}, line width=0.7pt},
  pmBidirected/.style={{Stealth[length=2mm]}-{Stealth[length=2mm]}, line width=0.7pt},
  pmCopath/.style={line width=1.6pt},
  pmLabel/.style={midway, fill=white, inner sep=1pt},
]
  \node[pmLatent] (z_mat_m) at (0.000,1.900) {$z^{(m)}_{m}$};
  \node[pmLatent] (z_pat_m) at (1.800,1.900) {$z^{(p)}_{m}$};
  \node[pmLatent] (g_m) at (0.900,0.000) {$g_m$};
  \node[pmLatent] (e_m) at (2.700,0.000) {$e_m$};
  \node[pmLatent] (z_mat_p) at (5.800,1.900) {$z^{(m)}_{p}$};
  \node[pmLatent] (z_pat_p) at (7.600,1.900) {$z^{(p)}_{p}$};
  \node[pmLatent] (g_p) at (6.700,0.000) {$g_p$};
  \node[pmLatent] (e_p) at (4.900,0.000) {$e_p$};
  \node[pmObserved] (y_m) at (1.400,-2.000) {$y_m$};
  \node[pmObserved] (y_p) at (6.200,-2.000) {$y_p$};
  \draw[pmDirected, draw=black] (z_mat_m) -- node[pmLabel] {$\beta$} (g_m);
  \draw[pmDirected, draw=black] (z_pat_m) -- node[pmLabel] {$\beta$} (g_m);
  \draw[pmDirected, draw=black] (z_mat_p) -- node[pmLabel] {$\beta$} (g_p);
  \draw[pmDirected, draw=black] (z_pat_p) -- node[pmLabel] {$\beta$} (g_p);
  \draw[pmDirected, draw=black] (g_m) -- (y_m);
  \draw[pmDirected, draw=black] (e_m) -- (y_m);
  \draw[pmDirected, draw=black] (g_p) -- (y_p);
  \draw[pmDirected, draw=black] (e_p) -- (y_p);
  \draw[pmCopath, draw=pmCB03A2E] (y_m) -- node[pmLabel] {$\left[\rho_{y}\right]$} (y_p);
\end{tikzpicture}
