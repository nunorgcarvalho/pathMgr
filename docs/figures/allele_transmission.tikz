  \draw[pmDirected, draw=black] (z_pat_f_0) -- (x_f_0);
  \draw[pmDirected, draw=black] (g_o) -- (y_o);
  \draw[pmDirected, draw=black] (e_o) -- (y_o);
  \draw[pmDirected, draw=black] (x_o_0) -- node[pmLabel] {$\beta_{0}$} (g_o);
