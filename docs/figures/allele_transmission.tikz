  \node[pmLatent] (z_mat_f_0) at (7.000,3.200) {$z^{(m)}_{f,0}$};
  \node[pmLatent] (z_pat_f_0) at (9.000,3.200) {$z^{(p)}_{f,0}$};
  \node[pmLatent] (g_o) at (4.500,-5.900) {$g_{o}$};
  \node[pmLatent] (e_o) at (6.900,-5.900) {$e_{o}$};
  \node[pmObserved] (y_o) at (4.500,-7.300) {$y_{o}$};
  \node[pmObserved] (x_o_0) at (4.500,-4.500) {$x_{o,0}$};
  \node[pmLatent] (z_mat_o_0) at (3.400,-3.000) {$z^{(m)}_{o,0}$};
  \node[pmLatent] (z_pat_o_0) at (5.600,-3.000) {$z^{(p)}_{o,0}$};
  \node[pmLatent] (s_mat_o_0) at (1.400,-3.000) {$s^{(m)}_{o,0}$};
  \node[pmLatent] (s_pat_o_0) at (7.600,-3.000) {$s^{(p)}_{o,0}$};
  \draw[pmDirected, draw=black] (g_m) -- (y_m);
  \draw[pmDirected, draw=black] (e_m) -- (y_m);
  \draw[pmDirected, draw=black] (x_m_0) -- node[pmLabel] {$\beta_{0}$} (g_m);
  \draw[pmDirected, draw=black] (z_mat_m_0) -- (x_m_0);
  \draw[pmDirected, draw=black] (z_pat_m_0) -- (x_m_0);
  \draw[pmDirected, draw=black] (g_f) -- (y_f);
  \draw[pmDirected, draw=black] (e_f) -- (y_f);
