  \node[pmLatent] (z_mat_m_0) at (0.000,3.200) {$z^{(m)}_{m,0}$};
  \node[pmLatent] (z_pat_m_0) at (2.000,3.200) {$z^{(p)}_{m,0}$};
  \node[pmLatent] (g_f) at (8.000,0.300) {$g_{f}$};
